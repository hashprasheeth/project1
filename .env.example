# --- Application ---
APP_NAME="E-Waste Detection System"
DEBUG=False
VERSION="1.0.0"

# --- Triton Inference Server ---
# Address where Triton is accessible from the Backend container
# In Docker Compose, this is the service name "triton"
TRITON_GRPC_URL=triton:8001

# Model Configuration
MODEL_NAME=efficientdet_d5
MAX_FILE_SIZE_MB=10

# --- Safety Logic ---
HAZARDOUS_THRESHOLD=0.40
# Comma separated list of hazardous e-waste classes
HAZARDOUS_CLASSES=["battery","battery_lithium","battery_alkaline","battery_lead_acid","circuit_board","pcb_bare","motherboard","capacitor","crt_monitor","tv_crt","light_bulb_cfl","processor","integrated_circuit","power_supply"]

# --- Database (Optional/Future) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
